{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "symposium",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },

  // The canonical, legacy, and retired hostnames the Worker answers on, and the
  // only ones — `workers_dev` is false. Declared here rather than clicked in the
  // dashboard so the repo describes the post-cutover target: the new domains
  // must exist in Cloudflare before this config can deploy.
  //
  // `custom_domain` makes Cloudflare create and own the DNS record, which is
  // why none of the zones should carry a hand-made record for these names. They
  // must match `vars` below exactly; the router fails closed on every other
  // host once any configured hostname is present.
  "routes": [
    { "pattern": "openartifacts.site", "custom_domain": true },
    { "pattern": "symposium.site", "custom_domain": true },
    { "pattern": "api.openartifacts.ai", "custom_domain": true },
    { "pattern": "api.symposium.md", "custom_domain": true },
    // One origin per publisher: `{label}.openartifacts.site`, the label being the
    // first 16 bytes of SHA-256("openartifacts-origin-v1:" + docs.owner) in
    // lowercase Crockford base32, 26 characters. A publisher's invited-only
    // documents are served only there; a custom hostname takes the same seat
    // later. A custom domain cannot be a wildcard, so this is a route, and it
    // needs the proxied DNS record `*.openartifacts.site AAAA 100::` that
    // docs/deploying.md has an operator add once. `resolveSurface` serves only a
    // 26-character label here and fails closed on every other subdomain.
    { "pattern": "*.openartifacts.site/*", "zone_name": "openartifacts.site" }
  ],

  // The limiter on POST /device/code, which is unauthenticated by necessity —
  // the caller has no credential yet, which is the entire reason it is asking.
  //
  // The binding rather than a D1 counter, because a counter in a row costs a
  // write per attempt including every refused one, so the limiter itself would
  // be the thing that exhausts a self-hoster's daily write budget under exactly
  // the abuse it exists to stop. docs/cost-at-scale.md says counters go here or
  // in a Durable Object, never in D1 rows. A refused request here costs
  // nothing.
  //
  // `namespace_id` is unique per account, not per Worker: an operator running
  // more than one Worker has to give each limiter its own. `period` accepts
  // only 10 or 60. `DEVICE_MINT_PERIOD_SECONDS` in src/config.ts must match the
  // period, since the Retry-After header is the only place the number is
  // needed in code.
  "ratelimits": [
    { "name": "DEVICE_CODE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // The approval page's own limit, on looking a user code up and on starting
    // a handshake against one. Separate from the mint's because it protects a
    // different thing — guessing a user code, rather than the write budget —
    // and because one ordinary sign-in spends three of a shared bucket.
    // Twenty a minute is meaningless against the code's own entropy and still
    // generous for somebody retyping a code off a phone.
    {
      "name": "APPROVAL_LOOKUP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    // Polling is keyed by the hash of the secret device code, not by address:
    // one machine cannot make another wait behind the same NAT. Keeping this in
    // a binding also makes every pending poll a D1 read instead of a timestamp
    // write. The advertised DEVICE_POLL_INTERVAL_SECONDS must match the period.
    {
      "name": "DEVICE_POLL_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1, "period": 10 }
    },
    // A separate address bucket runs before the D1 lookup. Per-code buckets
    // alone can be bypassed with a fresh random code on every request. Twenty
    // polls per ten seconds leaves ample room for shared networks while
    // bounding misses from one caller.
    {
      "name": "DEVICE_POLL_CLIENT_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 10 }
    },
    // Ceiling on PostHog view events, per document: 60 a minute. Deleting it
    // means no view events at all. See "Cost" in docs/analytics.md.
    {
      "name": "VIEW_EVENT_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    },
    // Emailed sign-in codes, counted per address: three a minute is a person
    // retrying, and well under what mailbombing an address needs. Absent means
    // no limit, as for the limiters above.
    {
      "name": "SIGNIN_EMAIL_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 3, "period": 60 }
    },
    // The same codes counted per client address, so one caller cannot use the
    // sign-in form to mail a code to many addresses. Absent means no limit.
    {
      "name": "SIGNIN_EMAIL_CLIENT_LIMITER",
      "namespace_id": "1009",
      "simple": { "limit": 10, "period": 60 }
    },
    // Invite emails, counted per owner. An owner who exceeds it still adds the
    // person; only the email is skipped.
    {
      "name": "INVITE_EMAIL_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 20, "period": 60 }
    },
    // Requests to open a document, counted per requesting account. It bounds
    // both the request rows one account can write and the emails those rows send
    // owners. An over-limit request stores nothing and still sees "Request sent".
    {
      "name": "REQUEST_ACCESS_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 10, "period": 60 }
    },
    // The Share popover's token claim, counted per client address. A waiting
    // frame polls every two seconds, so twenty per ten seconds leaves room for
    // several frames behind one address while bounding a flood of misses against
    // the D1 read budget. Absent means no limit.
    {
      "name": "EMBED_TOKEN_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 20, "period": 10 }
    },
    // Comment writes (a thread, a reply, a resolve or a reopen), counted per
    // principal. Over the limit the write is refused with `quota_exceeded` and a
    // `Retry-After`. Absent means no limit.
    {
      "name": "COMMENT_WRITE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 30, "period": 60 }
    },
    // Comment notification emails, counted per document. Over the limit the
    // comment still posts; only the email is skipped.
    {
      "name": "COMMENT_EMAIL_LIMITER",
      "namespace_id": "1012",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Invite emails, request emails to owners, and sign-in codes, sent through
  // Cloudflare Email Service from a dedicated subdomain (`EMAIL_FROM` below) so
  // abuse cannot hurt the brand domain's mail reputation. The binding needs
  // Workers Paid and an onboarded sending domain. `allowed_sender_addresses`
  // pins what this Worker may send from; a self-hoster changes it together with
  // `EMAIL_FROM`, and on the free plan deletes this block and `EMAIL_FROM`
  // altogether. Optional: a deployment without it sends no email and offers no
  // code sign-in, and Google and GitHub still work.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["share@mail.openartifacts.ai"] }],

  // R2 is the system of record: every served byte lives here.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "symposium-docs" }],

  // D1 holds pointer rows only (ids, sizes, timestamps) and is rebuildable
  // from R2. `database_id` is the real database, created 2026-07-25 in region
  // WNAM. It is not a secret — the binding does not resolve without it — and
  // local work (`wrangler dev`, `wrangler d1 ... --local`) ignores it entirely.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "symposium",
      "database_id": "59bdf562-6ffb-4e2e-a5b5-dc40f6f30bdc",
      "migrations_dir": "migrations"
    }
  ],

  // Inline comments: one SQLite Durable Object per document, addressed with
  // `COMMENTS.idFromName(docId)`. The class holds a document's threads and
  // comments; D1 only carries the owner's on/off switch. SQLite-backed Durable
  // Objects are available on the free Workers plan. The migration is a deploy
  // step: the class must exist before a Worker that binds it can be uploaded.
  "durable_objects": {
    "bindings": [{ "name": "COMMENTS", "class_name": "DocComments" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocComments"] }],

  // No workers.dev route, ever. `resolveSurface` falls back to path prefixes
  // only when every host var is empty, so an unconfigured workers.dev hostname
  // would serve /d/* — user HTML on a domain we cannot sacrifice, and one whose Public
  // Suffix List entry makes a listing hit every Worker on the account.
  // docs/serving-domain.md is the argument; docs/deploying.md covers the cost,
  // which is that the Worker has no hostname until a custom domain is attached.
  "workers_dev": false,

  // The surface split. Documents serve from the sacrificial domain, the API
  // from the brand one, and `resolveSurface` decides by host — so /api/v1 is
  // unreachable on openartifacts.site rather than merely unadvertised (see
  // docs/serving-domain.md, docs/cost-at-scale.md §6).
  //
  // Configure all four together. The old document host redirects GET and HEAD
  // with the exact path and query. The old API custom domain stays attached and
  // returns 410 for every request: a limited-zone Cloudflare token cannot
  // reliably delete a route in a zone omitted from the new config.
  //
  // Both new Cloudflare zones must exist before this config can ship. This is a
  // one-deploy cutover. Record its version as the rollback floor; older versions
  // would route the new hosts by path and make api.symposium.md live again.
  "vars": {
    "SERVING_HOST": "openartifacts.site",
    "API_HOST": "api.openartifacts.ai",
    "LEGACY_SERVING_HOST": "symposium.site",
    "RETIRED_API_HOST": "api.symposium.md",
    "DEFAULT_PLAN": "free",
    "ACCOUNT_ACTION_URL": "https://openartifacts.ai/account",
    "UPGRADE_URL": "https://openartifacts.ai/account",
    "EMAIL_FROM": "share@mail.openartifacts.ai",
    // Every paid plan includes private sharing, so `privateSharing` is on both
    // `pro` and `pro_lifetime` and absent from `free`. The license-key side has
    // no flag: any plan that may publish with a key (PUBLISHING_PLANS in
    // src/auth.ts) may share privately.
    "PLAN_LIMITS": "{\"free\":{\"documents\":3,\"pushesPerDay\":6,\"htmlBytes\":1048576},\"pro\":{\"documents\":500,\"pushesPerDay\":100,\"htmlBytes\":10485760,\"privateSharing\":true,\"comments\":true},\"pro_lifetime\":{\"documents\":500,\"pushesPerDay\":100,\"htmlBytes\":10485760,\"storageBytes\":5368709120,\"privateSharing\":true,\"comments\":true}}",

    // Product analytics labels every event with this; business queries filter
    // on it. A local run that turns delivery on must override it with
    // `--var ANALYTICS_ENVIRONMENT:development`. The ingest key is a secret and
    // POSTHOG_HOST defaults in code; see docs/analytics.md.
    "ANALYTICS_ENVIRONMENT": "production"
  }
}
