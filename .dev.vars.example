# Local secrets for `wrangler dev`. Copy to `.dev.vars` and fill in; `.dev.vars`
# is gitignored and must stay that way.
#
# In a deployed environment these are set with `wrangler secret put <NAME>`, not
# in wrangler.jsonc.

# Base url of the Brevilabs license server. The worker POSTs
# {LICENSE_API_URL}/api/trpc/license.validateLicenseKey to validate a publisher's
# Copilot Plus license key.
LICENSE_API_URL="https://api.brevilabs.com"

# Our server-side credential for that endpoint — NOT a publisher's license key.
# Publisher keys arrive per request in the Authorization header and are never
# stored; only their SHA-256 is.
LICENSE_API_KEY=""

# OAuth clients for the approval page, where a person proves an email address and
# an account is created. Both halves of a pair are needed before that provider is
# offered; a deployment that sets none still serves every document it has, and
# the approval page says it cannot create accounts.
#
# Register the callback with each provider verbatim, on the host the page is
# reached at:
#   https://api.openartifacts.ai/approve/callback/google
#   https://api.openartifacts.ai/approve/callback/github
# Locally that is http://127.0.0.1:8787/approve/callback/{provider}.
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""

# Signs the five-minute cookie that carries an OAuth handshake's state and PKCE
# verifier. Any long random string; rotating it only invalidates handshakes that
# are in flight, since nothing else is signed with it. Approval is unavailable
# while it is unset.
APPROVAL_COOKIE_SECRET=""
